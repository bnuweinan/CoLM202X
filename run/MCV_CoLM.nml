   DEF_file_mesh_atm = '/share/home/dq087/tangjy25/MCV2026/CCPL_PMCV/model_platform/models/CoLM/run/mesh_colm_MCV.nc'
   DEF_FAST_PC  = .true.
   DEF_PC_CROP_SPLIT = .true.

   DEF_USE_WUEST = .true.
   DEF_USE_PLANTHYDRAULICS = .true.
   DEF_USE_VariablySaturatedFlow = .true.
   DEF_RSS_SCHEME = 5
   DEF_Runoff_SCHEME = 3
   DEF_USE_SUPERCOOL_WATER = .true.
   DEF_SPLIT_SOILSNOW = .true.
   DEF_Interception_scheme=1

   ! LAI setting
   DEF_LAI_MONTHLY = .true.
   DEF_LC_YEAR = 2005
   DEF_LAI_CHANGE_YEARLY = .false.

   ! ---- SNICAR ----
   DEF_USE_SNICAR     = .true.
   DEF_Aerosol_Readin = .true.
   DEF_Aerosol_Clim   = .false.
   ! ----------------

   !for grid river lake flow
   DEF_UnitCatchment_file = '/share/home/dq013/zhwei/colm/data/CoLMruntime/unitcatchment/grid_routing_data_15min.nc'
   DEF_Reservoir_Method   = 1
   DEF_ReservoirPara_file = '/share/home/dq013/zhwei/colm/data/CoLMruntime/unitcatchment/grid_routing_data_15min.nc'

   !for BGC
