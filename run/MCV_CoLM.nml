   DEF_USE_OZONEDATA   = .false.
   ! ----------------------

   ! ---- Forcing Downscalling ----
   DEF_USE_Forcing_Downscaling        = .false.
   DEF_USE_Forcing_Downscaling_Simple = .false.
   DEF_DS_HiresTopographyDataDir      = '/share/home/dq013/zhwei/colm/data/CoLMrawdata/'
